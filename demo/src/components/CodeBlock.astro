---
interface Props {
  code: string;
  lang?: string;
  label?: string;
  maxHeight?: string;
}

const { code, lang = "text", label, maxHeight = "400px" } = Astro.props;
---

<div class="rounded-xl border border-zinc-800 overflow-hidden">
  {label && (
    <div class="flex items-center justify-between px-4 py-2 bg-zinc-800/60 border-b border-zinc-800">
      <span class="font-mono text-xs text-zinc-400">{label}</span>
      {lang !== "text" && (
        <span class="font-mono text-xs text-zinc-600">{lang}</span>
      )}
    </div>
  )}
  <div
    class="overflow-auto scrollbar-thin bg-zinc-900/50"
    style={`max-height: ${maxHeight}`}
  >
    <pre class="p-4 text-sm font-mono text-zinc-300 leading-relaxed whitespace-pre"><code>{code}</code></pre>
  </div>
</div>
