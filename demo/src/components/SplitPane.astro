---
interface Props {
  leftLabel?: string;
  rightLabel?: string;
}

const { leftLabel, rightLabel } = Astro.props;
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
  <div class="flex flex-col gap-2">
    {leftLabel && (
      <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider">{leftLabel}</span>
    )}
    <slot name="left" />
  </div>
  <div class="flex flex-col gap-2">
    {rightLabel && (
      <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider">{rightLabel}</span>
    )}
    <slot name="right" />
  </div>
</div>
