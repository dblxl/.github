---
interface Props {
  number: string;
  label: string;
  role: string;
  href: string;
  color: string;
  repoUrl: string;
}

const { number, label, role, href, color, repoUrl } = Astro.props;
---

<div
  class="group relative flex flex-col gap-4 p-6 rounded-xl border border-zinc-800 bg-zinc-900 hover:bg-zinc-800/80 transition-all hover:border-zinc-600"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex flex-col gap-1">
      <span class="font-mono text-xs text-zinc-500">Layer {number}</span>
      <span class="font-mono text-lg font-semibold" style={`color: ${color}`}>
        {label}
      </span>
    </div>
    <a
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-zinc-600 hover:text-zinc-300 transition-colors mt-1"
      aria-label={`${label} on GitHub`}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
    </a>
  </div>

  <p class="text-zinc-400 text-sm leading-relaxed">{role}</p>

  <a
    href={href}
    class="inline-flex items-center gap-1.5 font-mono text-xs transition-colors mt-auto"
    style={`color: ${color}`}
  >
    View demo
    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
      <path d="M3.75 2h8.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0112.25 14h-8.5A1.75 1.75 0 012 12.25v-8.5C2 2.784 2.784 2 3.75 2zm0 1.5a.25.25 0 00-.25.25v8.5c0 .138.112.25.25.25h8.5a.25.25 0 00.25-.25v-8.5a.25.25 0 00-.25-.25h-8.5zM6.72 7.22a.75.75 0 000 1.06l1.47 1.47-1.47 1.47a.75.75 0 101.06 1.06l2-2a.75.75 0 000-1.06l-2-2a.75.75 0 00-1.06 0z"/>
    </svg>
  </a>
</div>
